<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.hashbin</groupId>
    <artifactId>hashbin-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>hashbin-api</artifactId>
  <name>Hashbin API Client</name>
  <description>
    Java client for the hashbin.net timestamping API, GENERATED at build time from the OpenAPI
    document produced by the sibling hashbin-quarkus module (so it can never drift from the
    service). Uses the OpenAPI "java/microprofile" generator: a MicroProfile REST Client interface
    plus Jackson models. The HMAC signature verify (not expressible in OpenAPI) is hand-written on
    top of the generated models.
  </description>

  <properties>
    <!-- OpenAPI generator wiring. -->
    <openapi-generator.version>7.24.0</openapi-generator.version>
    <openapi.spec.dir>${project.build.directory}/openapi</openapi.spec.dir>
    <hashbin.api.package>net.hashbin.api</hashbin.api.package>
    <jackson.version>2.18.2</jackson.version>
    <!-- Jakarta / MicroProfile API versions the generated interfaces compile against
         (align with Quarkus 3.x; the consuming app supplies the runtime impl). -->
    <jakarta.ws.rs.version>3.1.0</jakarta.ws.rs.version>
    <microprofile.rest.client.version>4.0</microprofile.rest.client.version>
  </properties>

  <dependencies>
    <!--
      Build-order + spec carrier: depending on the service's generated OpenAPI artifact makes Maven
      build hashbin-quarkus first (it runs the quarkus build goal that writes the spec + -openapi.jar)
      and hands the artifact to maven-dependency-plugin to unpack. Provided + content-less (yaml/json
      only) => nothing on this library's runtime classpath and never published. Stays in-reactor.
    -->
    <dependency>
      <groupId>net.hashbin</groupId>
      <artifactId>hashbin-quarkus</artifactId>
      <version>${project.version}</version>
      <classifier>openapi</classifier>
      <type>jar</type>
      <scope>provided</scope>
    </dependency>

    <!-- Provided API jars the generated MicroProfile REST Client interfaces compile against.
         Quarkus (hashbin-cli) supplies the runtime impl via quarkus-rest-client-jackson. -->
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
      <version>${jakarta.ws.rs.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.microprofile.rest.client</groupId>
      <artifactId>microprofile-rest-client-api</artifactId>
      <version>${microprofile.rest.client.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Jackson: the generated models' serialization annotations + the hand-written helpers. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!-- 1) Unpack the service's OpenAPI document out of the -openapi.jar carrier. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-openapi</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>net.hashbin</groupId>
                  <artifactId>hashbin-quarkus</artifactId>
                  <version>${project.version}</version>
                  <classifier>openapi</classifier>
                  <type>jar</type>
                  <outputDirectory>${openapi.spec.dir}</outputDirectory>
                  <includes>openapi.yaml,openapi.json</includes>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 1b) Bundle the OpenAPI documents into this jar under META-INF/openapi, so consumers
                of hashbin-api also get the exact spec the client was generated from (nice-to-have:
                codegen, docs, self-inspection). Runs after unpack, before jar packaging. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>bundle-openapi</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/openapi</outputDirectory>
              <resources>
                <resource>
                  <directory>${openapi.spec.dir}</directory>
                  <includes>
                    <include>openapi.yaml</include>
                    <include>openapi.json</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 2) Generate the MicroProfile REST Client interface + Jackson models from that spec. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-client</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${openapi.spec.dir}/openapi.yaml</inputSpec>
              <generatorName>java</generatorName>
              <library>microprofile</library>
              <output>.</output>
              <addCompileSourceRoot>true</addCompileSourceRoot>
              <verbose>false</verbose>

              <!-- We generate into the project root (output=.) with sourceFolder pointed at
                   target/generated-sources, and prune the scaffolding via the committed
                   .openapi-generator-ignore (which lives at output=. = this module root). Its
                   /* and /*.* patterns discard depth-1 entries (pom.xml, README.md, etc.)
                   while the deeper generated sources under target/generated-sources/... survive.
                   generateSupportingFiles is ON so we also get the STOCK ApiException +
                   ApiExceptionMapper (the generated *Api interfaces throw ApiException) and the
                   RFC3339* helpers; the only hand-written glue left is BearerClientHeadersFactory. -->

              <!-- Generate the MicroProfile REST Client interfaces + the Jackson models. -->
              <generateApis>true</generateApis>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModels>true</generateModels>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateSupportingFiles>true</generateSupportingFiles>

              <configOptions>
                <configKey>hashbin</configKey>
                <microprofileRestClientVersion>3.0</microprofileRestClientVersion>
                <rootJavaEEPackage>jakarta</rootJavaEEPackage>
                <useJakartaEe>true</useJakartaEe>
                <useRuntimeException>true</useRuntimeException>
                <microprofileRegisterExceptionMapper>false</microprofileRegisterExceptionMapper>
                <serializationLibrary>jackson</serializationLibrary>
                <microprofileMutiny>false</microprofileMutiny>
                <withXml>false</withXml>
                <useBeanValidation>false</useBeanValidation>
                <openApiNullable>false</openApiNullable>
                <generateBuilders>true</generateBuilders>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <sourceFolder>target/generated-sources</sourceFolder>
                <apiPackage>${hashbin.api.package}</apiPackage>
                <modelPackage>${hashbin.api.package}.model</modelPackage>
                <invokerPackage>${hashbin.api.package}</invokerPackage>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
