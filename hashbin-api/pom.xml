<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.hashbin</groupId>
    <artifactId>hashbin-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>hashbin-api</artifactId>
  <name>Hashbin API Client</name>
  <description>
    Plain-Java client for the hashbin.net timestamping API: typed request/response models, an
    HttpClient wrapper for the /api routes, and the HMAC scheme used to verify server signatures.
    Depends only on Jackson — no Quarkus — so any JVM consumer can pin it as a versioned dependency.
  </description>

  <properties>
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <!-- JSON binding for the wire contract (snake_case). Plain Jackson, not quarkus-jackson. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
