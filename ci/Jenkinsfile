// Jenkins pipeline for the hashbin-backend service: builds and tests the reactor, then builds and
// pushes a container image to the org Harbor — a JVM image by default, the native one when the
// BUILD_NATIVE parameter is true. On main/master it also deploys `hashbin-api` (plus this parent pom,
// which its pom references) to SBForge's public Nexus, which is how sibling projects such as
// hashbin-cli resolve it without a local checkout of this repo.
//
// The stages themselves live in the org's Platform shared library, in `vars/DinDImageBuild.groovy`:
// test in a JDK container, then `docker build --target final` + push with a dind-rootless daemon.
// Nothing here is hashbin-specific except the values below — the image name, the two recipes, the JDK,
// and the Nexus command. Why that shape, and why `DockerfileBuild` (five-stage contract, tests only
// inside the image) could not be used, is documented in the var's header and in README
// "CI (Jenkins)" / "Decisions & gotchas". `DinDBuild` is the same pipeline without the image stage;
// it is now a deprecated wrapper around this var, so this call does not have to choose between them.
//
// Why `ci/Jenkinsfile` and not the repository root: the org runs two Jenkins controllers that find
// pipelines by *path* — the legacy one reads `Jenkinsfile` in the root, the current one
// `ci/Jenkinsfile`. Sitting under `ci/` means only the current controller builds this repo and
// posts the PR commit status, so a pull request is gated by exactly one real build.

library identifier: 'DinDImageBuild@dindimagebuild-replaces-dindbuild', retriever: modernSCM(scm: [$class: 'GitSCMSource', remote: 'https://sbprojects.statsbiblioteket.dk/stash/scm/ist/jenkins-shared.git', credentialsId: 'sbprojects-stash'], libraryPath: "Platform") _

DinDImageBuild {
    // The wrapper builds on the image's JDK 25; the library default is the JDK 21 image DinDBuild
    // uses. `buildCommand` and `mavenExecutable` are left at their defaults, which are exactly
    // './mvnw $MAVEN_CONFIG --no-transfer-progress clean install'.
    jdkImage = 'eclipse-temurin:25-jdk-ubi10-minimal'

    // A PINNED literal, deliberately not derived from the git repo slug: renaming the GitHub repo
    // must not move the image that consumers (hashbin-deploy) pull. Kept equal to the OSS
    // ghcr.io/blekinge/hashbin-backend image name.
    projectName = 'hashbin-backend'
    // The Bitbucket-for-Jenkins env vars are null on this GitHub job, so the Harbor library segment —
    // the org account 'blekinge' — has to be stated rather than derived.
    harborLibrary = 'blekinge'

    // Both recipes build from source with a `final` stage. JVM is the fast default; native is the
    // (slow, multi-minute) long-term target, selected by the BUILD_NATIVE parameter the library
    // declares because a nativeDockerfile is passed.
    dockerfile = 'hashbin-quarkus/src/main/docker/Dockerfile.jvm-multi-stage'
    nativeDockerfile = 'hashbin-quarkus/src/main/docker/Dockerfile.native-multi-stage'
    timeoutMinutes = 45

    // The library runs this only on main/master: every merge would otherwise push the same
    // 1.0.0-SNAPSHOT from feature branches too, and the last writer wins — consumers must see exactly
    // what is on main. The parent pom must be in the reactor because hashbin-api's pom references it;
    // hashbin-quarkus is deliberately NOT, since a service is distributed as a container image, not a
    // Maven artifact. Credentials for <server id="sbforge-nexus"> come from the settings.xml that
    // withMaven() provides. Single-quoted so $MAVEN_CONFIG reaches the shell, not Groovy.
    nexusDeployCommand = './mvnw $MAVEN_CONFIG --errors --activate-profiles sbforge-nexus' +
                         ' --define sbforge-nexus deploy --projects .,hashbin-api --define skipTests'
}
