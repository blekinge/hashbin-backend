// Self-contained Jenkins pipeline for the hashbin-quarkus backend. No shared-library calls on
// purpose: the org's `DockerfileBuild` can't run this project's tests and `DinDBuild` can't push
// its image (see the "why" in docs/HANDOFF.md). This one run builds, tests, and pushes a **native**
// container image to the org Harbor.
//
// Why `ci/Jenkinsfile` and not the repository root: the org runs two Jenkins controllers that find
// pipelines by *path* — the legacy one reads `Jenkinsfile` in the root, the current one
// `ci/Jenkinsfile`. Sitting under `ci/` means only the current controller builds this repo and
// posts the PR commit status, so a pull request is gated by exactly one real build.
//
// Pod layout (three containers) and why:
//   * Stage 1 (tests) deliberately does NOT go through Testcontainers. The suite uses Quarkus Dev
//     Services (no JDBC URL => Testcontainers starts Postgres in a container), but docker-java in
//     Testcontainers 1.20.6 negotiates Docker API v1.32, which modern daemons reject ("minimum
//     supported API version is 1.40") and DOCKER_API_VERSION is ignored by that client (see
//     docs/HANDOFF.md — it is why local dev uses Podman). So the pod runs a plain `postgres`
//     sidecar and the build points its datasource at it, bypassing Dev Services entirely.
//   * Stage 2 builds the **native** image with `docker build` of a multi-stage recipe whose builder
//     stage is Mandrel/JDK-21 (native-image runs there — no GraalVM on the agent). That needs a
//     Docker daemon, so a `docker:dind-rootless` sidecar stays; the docker CLI / BuildKit it drives
//     speak a modern API, so the version problem above does not apply to the image build.
// All containers share the Jenkins workspace volume. The Harbor naming + `jenkins-harbor`
// credential mirror `DockerfileBuild`.

pipeline {
    agent {
        kubernetes {
            yaml """
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  # jdk: runs ./mvnw — compile + the test suite, against the postgres sidecar.
                  - name: jdk
                    image: eclipse-temurin:21-jdk-ubi9-minimal
                    command: [cat]
                    tty: true
                    env:
                    # Test against the `postgres` sidecar instead of Dev Services/Testcontainers (see
                    # header: docker-java 1.20.6's API version is rejected by modern daemons). A set
                    # JDBC URL disables Dev Services for the datasource; Flyway migrates it at start.
                    - name: QUARKUS_DATASOURCE_JDBC_URL
                      value: jdbc:postgresql://localhost:5432/hashbin
                    - name: QUARKUS_DATASOURCE_USERNAME
                      value: hashbin
                    - name: QUARKUS_DATASOURCE_PASSWORD
                      value: hashbin
                    - name: QUARKUS_DATASOURCE_DEVSERVICES_ENABLED
                      value: "false"
                    resources:
                      requests: { memory: "1Gi" }
                      limits:   { memory: "4Gi" }
                    volumeMounts:
                    - name: pgdata
                      mountPath: /var/lib/postgresql/data
                  # postgres: the throwaway database the tests run against.
                  - name: postgres
                    image: docker.io/library/postgres:16-alpine
                    env:
                    - name: POSTGRES_USER
                      value: hashbin
                    - name: POSTGRES_PASSWORD
                      value: hashbin
                    - name: POSTGRES_DB
                      value: hashbin
                    - name: PGDATA
                      value: /var/lib/postgresql/data/pgdata
                    # Gate pod readiness on the DB accepting connections, so the test build never
                    # races Postgres startup.
                    readinessProbe:
                      exec:
                        command: ["pg_isready", "-U", "hashbin", "-d", "hashbin"]
                      initialDelaySeconds: 3
                      periodSeconds: 3
                      timeoutSeconds: 3
                      failureThreshold: 40
                    resources:
                      requests: { memory: "256Mi" }
                      limits:   { memory: "1Gi" }
                    volumeMounts:
                    - name: pgdata
                      mountPath: /var/lib/postgresql/data
                  # docker: the daemon that builds + pushes the native image (stage 2 only). Rootless
                  # dind is privileged-capable; the CLI here uses its own local unix socket (no
                  # DOCKER_HOST override => no HTTP-to-TLS mismatch).
                  - name: docker
                    image: docker:dind-rootless
                    tty: true
                    securityContext:
                      privileged: true
                    resources:
                      requests: { memory: "4Gi" }
                      limits:   { memory: "8Gi" }
                  volumes:
                  - name: pgdata
                    emptyDir: {}
                """
            retries 2
        }
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')       // cold agent: pull base + Mandrel images, warm Maven, native-compile
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    stages {
        stage('Build and test') {
            steps {
                container('jdk') {
                    withMaven() {
                        // The wrapper downloads Maven 3.9.16 and builds on the image's JDK 21 (the
                        // only JDK Quarkus 3.20's Hibernate build accepts). -PallTests runs the full
                        // suite; the datasource env above points it at the postgres sidecar.
                        sh './mvnw --batch-mode --no-transfer-progress -PallTests clean install'

                        // Capture the version for the image tag now, while we have the wrapper and
                        // JDK here; the image stage runs in the sidecar container, which has no JDK.
                        // Bare Groovy (def / assignment) must be inside script{} in a Declarative
                        // steps{} block — a raw `def` there is a compilation error, not a step.
                        script {
                            def version = sh(returnStdout: true, script: '''
                                ./mvnw --batch-mode --quiet --define forceStdout \
                                  --define expression=project.version help:evaluate
                            ''').trim()
                            env.PROJECT_VERSION = version
                            echo "Project version: ${version}"
                        }
                    }
                }
            }
        }

        stage('Build and push native image') {
            steps {
                container('docker') {
                    script {
                        // Harbor image path: harbor.tools.nyx.kb.dk/blekinge/<repo>.
                        // The library segment is the org account 'blekinge' (the Bitbucket-for-
                        // Jenkins env vars are null on this GitHub job, so don't depend on them).
                        def harborName = 'harbor.tools.nyx.kb.dk'
                        def harborLibrary = 'blekinge'
                        // Repo name: Bitbucket var, else GitHub's REPO, else this repo's literal.
                        def projectName = env.BITBUCKET_REPOSITORY ?: env.REPO ?: 'hashbin-quarkus'

                        def validBranchTag = (env.BRANCH_NAME ?: 'dev')
                            .replace('/', '-').replace('+', '-').replace('_', '-')
                            .toLowerCase().take(30).replaceAll(/-+$/, '')

                        def imageVersion = "${env.PROJECT_VERSION}-${validBranchTag}-sha.${env.GIT_COMMIT}-build.${env.BUILD_NUMBER}"
                        env.IMAGE_TAG = "${harborName}/${harborLibrary}/${projectName}:${imageVersion}"
                        echo "Building and pushing ${env.IMAGE_TAG}"
                    }

                    // Build from source. DOCKER_BUILDKIT=1 honours `# syntax=docker/dockerfile:1`
                    // and enables the modern builder. The native binary compiles inside the Mandrel
                    // builder stage, so no GraalVM and no nested container build.
                    sh '''
                        set -eu
                        export DOCKER_BUILDKIT=1
                        docker build \
                          --target final \
                          --tag "$IMAGE_TAG" \
                          --file src/main/docker/Dockerfile.native-multi-stage \
                          .
                    '''

                    withCredentials([usernamePassword(credentialsId: 'jenkins-harbor',
                                                      usernameVariable: 'USERNAME',
                                                      passwordVariable: 'PASSWORD')]) {
                        sh '''
                            set -eu
                            printf '%s' "$PASSWORD" | docker login harbor.tools.nyx.kb.dk \
                              --username "$USERNAME" --password-stdin
                            docker push "$IMAGE_TAG"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Published ${env.IMAGE_TAG}"
        }
    }
}
