####
# Native runtime image for hashbin-quarkus — the image hashbin-deploy pulls.
#
# This is the single-stage image the `quarkus-container-image-docker` extension
# builds when packaging with `-Dnative`. The native executable itself is compiled
# beforehand in a Mandrel builder container (we set `quarkus.native.container-build
# =true` in the `native` Maven profile), so this stage only needs a minimal base
# plus the finished `*-runner` binary — no GraalVM here.
#
# Build it (Docker):
#   mvn -Dnative -Dquarkus.container-image.build=true \
#       -Dquarkus.container-image.tag=1.0.0 -DskipTests package
# Against rootless Podman add:
#   -Dquarkus.docker.executable-name=podman -Dquarkus.native.container-runtime=podman
#
# Runs as the non-root UID 185 (matches the Deployment's runAsNonRoot) and listens
# on 8080 (matches containerPort).
####
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.5
WORKDIR /work/
COPY --chown=185 target/*-runner /work/application
RUN chmod 775 /work
EXPOSE 8080
USER 185
CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
