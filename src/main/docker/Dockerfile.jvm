####
# JVM runtime image for hashbin-quarkus. Not used by hashbin-deploy (which pulls
# the native image), but kept so `mvn -Dquarkus.container-image.build=true package`
# works in JVM mode too — handy for quick, GraalVM-free smoke builds.
#
# Build it (Docker):
#   mvn -Dquarkus.container-image.build=true -DskipTests package
# Against rootless Podman add: -Dquarkus.docker.executable-name=podman
#
# Runs as the non-root UID 185 and listens on 8080.
####
FROM registry.access.redhat.com/ubi9/openjdk-21:1.21

ENV LANGUAGE='en_US:en'

# Four distinct layers so library layers are reused when only app code changes.
COPY --chown=185 target/quarkus-app/lib/  /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/  /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
