# syntax=docker/dockerfile:1
####
# CI build recipe for the hashbin-quarkus **JVM** image: compiles the Quarkus app with Maven
# (NO native-image) in a JDK-21 + Maven stage, then runs it on a minimal JRE. This is the fast CI
# default while the native build is off — set BUILD_NATIVE='true' in ci/Jenkinsfile to build
# Dockerfile.native-multi-stage instead. Mirrors hashbin-web's Dockerfile.ci (build from source,
# so the pushed image never depends on a locally built artifact).
#
# Runs non-root (UID 185) on :8080 to match the Deployment's securityContext/containerPort.
####
FROM docker.io/library/maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
# Optional org-Nexus settings secret (skipped when not supplied; all deps are public).
RUN mkdir -p "$HOME/.m2" && ln -sf /run/secrets/settings.xml "$HOME/.m2/settings.xml"
COPY . .
RUN --mount=type=secret,id=settings.xml \
    --mount=type=secret,id=settings-security.xml \
    --mount=type=cache,target=/root/.m2/repository \
    mvn --batch-mode --no-transfer-progress --errors \
      -P '!web' \
      -DskipTests \
      package

# ---- final: minimal JRE running the Quarkus fast-jar (target/quarkus-app) --------------
FROM docker.io/eclipse-temurin:21-jre-ubi9-minimal AS final
WORKDIR /app
# Four layers so library layers are reused when only app code changes.
COPY --from=build /build/target/quarkus-app/lib/     /app/lib/
COPY --from=build /build/target/quarkus-app/*.jar    /app/
COPY --from=build /build/target/quarkus-app/app/     /app/app/
COPY --from=build /build/target/quarkus-app/quarkus/ /app/quarkus/
EXPOSE 8080
USER 185
CMD ["java", "-Dquarkus.http.host=0.0.0.0", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/app/quarkus-run.jar"]
